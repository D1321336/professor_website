{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "professor-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "professor-website-db",
      "database_id": "57bd1d8e-bb0b-4bab-8c5b-5dab20311a03",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "professor-website-media"
    }
  ]
}
